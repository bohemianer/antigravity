{
  "manifest_version": 3,
  "name": "Antigravity",
  "version": "1.0.0",
  "description": "Antigravity - 专为外刊深度阅读定制的极简划词与全能生词本神器（WebDAV 双向云同步·标准音标·规范释义·完整语境沉淀）。",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "https://*.youdao.com/*",
    "https://translate.googleapis.com/*",
    "https://dav.jianguoyun.com/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Antigravity"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "options_page": "notebook.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
